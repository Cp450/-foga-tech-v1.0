# ─── API ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# PostgreSQL (KVM2 natif)
DATABASE_URL=postgresql://foga:foga_dev@localhost:5432/foga_tech

# CORS (production, comma-separated)
CORS_ORIGINS=https://foga-tech.com,https://www.foga-tech.com

# Base publique (pour logos PDF — laisse vide en dev)
PUBLIC_BASE=https://foga-tech.com

# ─── SMTP (Hostinger) ───────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@foga-tech.com
SMTP_PASS=
SMTP_FROM=contact@foga-tech.com
DEVIS_TO=contact@foga-tech.com
DEVIS_REPLY_TO=

# ─── Frontend (Vite) ────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
