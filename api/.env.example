# ─── DATABASE ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://foga:foga_dev@localhost:5432/foga_tech

# ─── SERVER ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ───────────────────────────────────────────────────────────────────
# Domaines autorisés en production (séparés par virgule, sans espace)
CORS_ORIGINS=https://foga-tech.com,https://www.foga-tech.com

# ─── SMTP (Hostinger) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@foga-tech.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Foga-Tech BTP <contact@foga-tech.com>"

# ─── EMAIL DESTINATAIRES ────────────────────────────────────────────────────
DEVIS_TO=contact@foga-tech.com
DEVIS_REPLY_TO=contact@foga-tech.com
# Destinataire des messages du formulaire de contact (défaut : DEVIS_TO).
# CONTACT_TO=contact@foga-tech.com
# URL publique de cette API (logos des e-mails). Défaut : https://api.foga-tech.com
# API_URL=https://api.foga-tech.com

# ─── n8n : qualification IA des devis ───────────────────────────────────────
# Webhook n8n appelé à chaque devis / location. C'est n8n qui crée la ligne SCORÉE que le
# dashboard affiche ; sans lui, une demande de devis brute reste masquée dans l'écran Activité.
# N8N_DEVIS_WEBHOOK=https://flow.example.com/webhook/lead-in

# ─── PDF / FRONTEND ──────────────────────────────────────────────────────────
# URL publique du frontend (pour logos dans le PDF généré)
PUBLIC_BASE=https://foga-tech.com

# ─── PUPPETEER (KVM2 Ubuntu) ─────────────────────────────────────────────────
# Installer Chromium : apt install -y chromium-browser
# Puis décommenter la ligne ci-dessous :
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ─── NOCODB (CRM) ────────────────────────────────────────────────────────────
# Table leads du CRM : devis, location ET contact y sont écrits.
# NOCODB_API_URL=https://nocodb.example.com
# NOCODB_API_TOKEN=your_nocodb_xc_token_here
# NOCODB_TABLE_ID=your_leads_table_id_here

# ─── NOTIFICATIONS DASHBOARD (Web Push) ──────────────────────────────────────
# Le site prévient le dashboard FOGA-TECH à chaque contact / devis / location.
# URL publique du dashboard (sans slash final) et secret = N8N_SECRET du dashboard.
# Dormant (log warn) si l'une des deux est absente.
# DASHBOARD_PUSH_URL=https://dashboard.example.com
# DASHBOARD_PUSH_TOKEN=your_dashboard_webhook_secret_here

# ─── ANTI-SPAM ───────────────────────────────────────────────────────────────
# Limitation de débit par IP sur contact + devis + location (défauts ci-dessous).
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MIN=10
# Nombre de reverse proxys devant l'API (req.ip = IP visiteur). Défaut 1.
# TRUST_PROXY=1

# ─── CHATWOOT (chat du site : « parler à un conseiller ») ────────────────────
# Dans Chatwoot : Paramètres > Boîtes de réception > Ajouter > canal « API »
# (l'API publique « client » utilise l'inbox_identifier d'un canal API ; un canal
# Website expose un website_token différent, utilisé par le widget). Puis copier
# l'« Inbox identifier » (Paramètres de la boîte > Configuration).
# Dormant (log warn) si l'une des deux est absente : lead NocoDB + notification
# dashboard fonctionnent quand même.
# CHATWOOT_URL=https://chatwoot.example.com
# CHATWOOT_INBOX_IDENTIFIER=
